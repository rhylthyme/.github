      },
      {
        "name": "ground cumin",
        "measure": "2 tsp"
      },
      {
        "name": "bay leaves",
        "measure": "2"
      },
      {
        "name": "salt",
        "measure": ""
      },
      {
        "name": "tomatoes",
        "measure": "6"
      },
      {
        "name": "white onions",
        "measure": "1½"
      },
      {
        "name": "jalapeños",
        "measure": "2"
      },
      {
        "name": "cilantro",
        "measure": "1 bunch"
      },
      {
        "name": "limes",
        "measure": "16"
      },
      {
        "name": "tequila blanco",
        "measure": "350 ml"
      },
      {
        "name": "triple sec",
        "measure": "175 ml"
      },
      {
        "name": "corn tortillas",
        "measure": "24"
      },
      {
        "name": "crema or sour cream",
        "measure": "200 g"
      },
      {
        "name": "cotija or feta",
        "measure": "150 g"
      }
    ]
  }
}
